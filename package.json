{
  "name": "homectl",
  "version": "0.1.0",
  "description": "Operate your homelab and small cloud fleet from one terminal",
  "bin": {
    "homectl": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "setup": "node setup.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "ci": "npm ci && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"if(!process.env.CI)process.exit(0)\" || npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "node-ssh": "^13.1.0",
    "dockerode": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^25.8.0",
    "@types/js-yaml": "^4.0.9",
    "@types/dockerode": "^4.0.0"
  }
}
