# homectl configuration
# Customize for your homelab and cloud infrastructure.

version: 1

defaultContext: lab

contexts:
  - name: lab
    host: media-node
    tags: [personal, homelab]

  - name: prod
    host: vps-1
    tags: [personal, production]

hosts:
  - name: local
    connection:
      type: local
      host: localhost
    runtime:
      docker: true
      compose: true
    tags: [local, dev]

  - name: media-node
    connection:
      type: ssh
      host: media.local
      user: pi
      identityFile: ~/.ssh/homelab_ed25519
    runtime:
      docker: true
      compose: true
    paths:
      composeRoot: /home/pi/docker
    tags: [media, lan]

  - name: automation-node
    connection:
      type: ssh
      host: automation.local
      user: admin
      identityFile: ~/.ssh/homelab_ed25519
    runtime:
      docker: true
      compose: true
    tags: [automation, lan]

  - name: db-node
    connection:
      type: ssh
      host: db.local
      user: admin
      identityFile: ~/.ssh/homelab_ed25519
    runtime:
      docker: true
      compose: false
    tags: [db, storage]

  - name: vps-1
    connection:
      type: ssh
      host: 203.0.113.10
      user: deploy
      port: 2222
      identityFile: ~/.ssh/vps_deploy
    runtime:
      docker: true
      compose: false
    tags: [cloud, prod]

  - name: edge-node
    connection:
      type: ssh
      host: 10.0.0.5
      user: root
      identityFile: ~/.ssh/homelab_ed25519
    runtime:
      docker: true
      compose: true
    tags: [edge, networking]

services:
  - name: n8n
    host: automation-node
    stack: n8n-stack
    composeService: n8n
    healthcheck:
      type: http
      url: http://automation.local:5678/healthz
      interval: 30
      timeout: 10

  - name: navidrome
    host: media-node
    stack: media-stack
    composeService: navidrome
    healthcheck:
      type: http
      url: http://media.local:4533/ping
      interval: 30
      timeout: 10

  - name: postgres
    host: db-node
    healthcheck:
      type: tcp
      port: 5432
      timeout: 5

backup:
  baseDir: ~/homectl-backups
  schedules:
    postgres:
      hosts: [db-node, vps-1]
      paths:
        - /var/lib/docker/volumes
      databases: [postgres]
      retentionDays: 30
    configs:
      hosts: [media-node, automation-node]
      paths:
        - /home/*/docker-compose.yml
        - /etc/nginx
        - /etc/traefik
      retentionDays: 90
    weekly:
      hosts: [media-node, automation-node, vps-1]
      paths:
        - /etc
        - /home/*/data
      retentionDays: 7
